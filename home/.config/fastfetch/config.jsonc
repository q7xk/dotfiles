
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/home/q7xk/.config/fastfetch/logo.txt",
    "color": {
      "1": "#7AA2F7",
      "2": "#BB9AF7"
    },
    "padding": {
      "top": 2,
      "right": 4
    }
  },

  "display": {
    "separator": "  󰁔  ",
    "color": {
      "keys": "#7AA2F7",
      "title": "#BB9AF7"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell"
    },
    {
      "type": "display",
      "key": "󰍹 Display"
    },
    {
      "type": "wm",
      "key": "󱂬 WM"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

